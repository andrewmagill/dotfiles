# macOS packages — installed with: brew bundle --file=packages/Brewfile
brew "zsh"
# neovim is installed from the pinned official prebuilt release by bootstrap.sh
# (Homebrew floats to latest; we pin 0.11.x) — see install_neovim().
brew "git"
brew "stow"
brew "ripgrep"
brew "fd"
brew "bat"
brew "git-delta"
brew "fzf"
brew "curl"
brew "starship"
brew "mise"

# AWS CLI (v2). On Linux, bootstrap.sh installs v2 via AWS's official installer.
brew "awscli"

# Containers: rootless, daemonless engine (also in apt.txt/dnf.txt). On macOS it
# needs a Linux VM — run `podman machine init && podman machine start` once.
brew "podman"

# shell dev tooling: shellcheck (pre-commit lint) + bats (test runner)
brew "shellcheck"
brew "bats-core"

# pre-commit secret scanner (see .githooks/pre-commit). Not packaged for
# apt/dnf — on Linux, bootstrap.sh installs the pinned release binary (see
# install_ripsecrets()); the hook warns loudly if it's absent.
brew "ripsecrets"

# gitleaks: on-demand full-history secret audits (`gitleaks git .`) —
# complements the ripsecrets hook scan. Linux: see install_gitleaks().
brew "gitleaks"

# sqlcmd (go-sqlcmd): modern single-binary SQL Server CLI — no ODBC/EULA. On
# Linux, bootstrap.sh installs the pinned release binary (see install_sqlcmd()).
brew "sqlcmd"

# PostgreSQL 16 — matches the version Rocky 10 and Ubuntu 24.04 ship. Versioned
# formulas are keg-only (not linked into /opt/homebrew/bin); .zshenv adds
# /opt/homebrew/opt/postgresql@16/bin to PATH. Server managed via
# `brew services` — bootstrap starts it (see setup_postgresql()).
brew "postgresql@16"

# sqlite3: macOS ships /usr/bin/sqlite3, so no formula needed here.

# Terminal emulator (uses the config in common/.config/kitty/)
cask "kitty"

# Font: Sono is installed by bootstrap.sh (install_fonts) — it isn't on Homebrew.
