#!/usr/bin/env bash
# Pre-commit hook: scan staged changes for secrets, then lint staged shell
# scripts with ShellCheck.
#
# Enabled automatically by bootstrap.sh (git config core.hooksPath .githooks),
# or turn it on manually in a clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

# --- Secret scan --------------------------------------------------------------
# ripsecrets scans the staged diff and fails the commit if it finds anything
# key/token-shaped. This is defense-in-depth on top of the .gitignore filename
# patterns and the out-of-tree $ZSH_LOCAL_DIR — it catches a credential pasted
# into an *otherwise-tracked* file, which filename rules can't.
#
# We chose ripsecrets over gitleaks for this hook: it's purpose-built for the
# staged pre-commit case — fast, low false-positive, near-zero config. gitleaks'
# edge is scanning full git *history* and a much larger ruleset; bootstrap
# installs it too — run `gitleaks git .` for an on-demand full-history audit,
# and revisit wiring it into CI someday. (See README → Secrets.)
if command -v ripsecrets >/dev/null 2>&1; then
  echo "pre-commit: ripsecrets…"
  # No args → ripsecrets scans the currently-staged files. Non-zero exit (a
  # finding) aborts the commit via set -e.
  ripsecrets
else
  # Loud but non-blocking: a missing scanner means this commit is NOT being
  # checked for leaked credentials. bootstrap.sh installs it on every OS.
  printf '\033[1;33mpre-commit WARNING:\033[0m ripsecrets not installed — this commit was NOT scanned for secrets.\n' >&2
  printf '  fix: ./bootstrap.sh   (or: brew install ripsecrets)\n' >&2
fi

# --- Shell lint ---------------------------------------------------------------
if ! command -v shellcheck >/dev/null 2>&1; then
  echo "pre-commit: shellcheck not installed — skipping shell lint" >&2
  exit 0
fi

# Staged shell scripts. Written portably (no bash-4 mapfile) so it also runs
# under macOS's system bash 3.2.
files="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(sh|bash)$|(^|/)bootstrap\.sh$|^\.githooks/' || true)"

[[ -n "$files" ]] || exit 0

echo "pre-commit: shellcheck…"
# shellcheck disable=SC2086  # word-split the newline-separated list (no spaced paths here)
shellcheck $files
